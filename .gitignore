# ================================================================
# TERAFORT ANALYTICS — .gitignore
# ================================================================
# Prevents accidental commits of credentials, build artifacts,
# and editor metadata.
# ================================================================

# --- CRITICAL: NEVER COMMIT CREDENTIALS -----------------------
*.json                    # GCP service account keys
!package.json             # ...except npm config (if ever added)
!package-lock.json
.env                      # local environment variable file
.env.*
!.env.example             # ...the template IS committed
*.key
*.pem
secrets/

# --- dbt artifacts (regenerated on every run) -----------------
target/
dbt_packages/
logs/
.dbt/

# --- Elementary artifacts -------------------------------------
edr_target/
elementary_output/
*.html

# --- Python ----------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# --- VS Code / IDEs -------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
# --- macOS / Windows / Linux ----------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Jupyter notebooks (if ever used for analysis) ------------
.ipynb_checkpoints/

# --- dbt-specific ---------------------------------------------
# Compiled SQL (regenerated on every run — never commit)
**/compiled/
**/run/

# Manifest + catalog (regenerated by `dbt docs generate`)
manifest.json
catalog.json
run_results.json
sources.json
partial_parse.msgpack

# --- OS noise --------------------------------------------------
*.log
*.tmp
*.bak
