# ================================================================
# SQLFLUFF CONFIGURATION — SQL LINTER FOR dbt + BIGQUERY
# ================================================================
# Enforces consistent SQL style across the team. Runs in CI on
# every PR — broken style = blocked merge.
#
# Customized for:
#   - BigQuery dialect (backticks, _PARTITIONTIME, etc.)
#   - dbt Jinja templating (refs, sources, macros)
#   - Lowercase keywords (modern preference)
#   - Leading commas (easier diff reviews)
# ================================================================

[sqlfluff]
# Use the dbt-aware template runner so {{ ref() }} works
templater = dbt
dialect = bigquery
runaway_limit = 10
max_line_length = 120
indent_unit = space
output_line_length = 120

# Rules to exclude (too pedantic for our use case)
exclude_rules =
    LT05,
    ST06,
    AM06,
    RF01

[sqlfluff:indentation]
tab_space_size = 2
indented_joins = false
indented_using_on = true
template_blocks_indent = false

[sqlfluff:layout:type:comma]
spacing_before = touch
line_position = trailing

# --- Rule-specific configs --------------------------------------

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower

[sqlfluff:rules:references.special_chars]
allow_space_in_identifier = false
additional_allowed_characters = "_"

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = consistent

# --- dbt-specific paths -----------------------------------------

[sqlfluff:templater:dbt]
project_dir = ./
profiles_dir = ./
profile = terafort
target = dev
